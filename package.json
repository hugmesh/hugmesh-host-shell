{
  "name": "@hugmesh/host-shell",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start-dev": "ng serve",
    "start": "node server.js",
    "buildDev": "ng build --watch --configuration development",
    "build": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "deploy": "gh-pages -d build",
    "test": "ng test --watch false",
    "coverage": "ng test --no-watch --code-coverage --browsers=ChromeHeadlessCI",
    "e2e": "nightwatch  -r ./e2e/html-reporter.js nightwatch.conf.js -e chrome",
    "e2e:test": "./node_modules/.bin/nightwatch --env 'chrome' --config './nightwatch.conf.js'",
    "e2e:integration": "nightwatch -r ./e2e/html-reporter.js nightwatch.conf.js -e chrome --tag cluster",
    "e2e:nginx": "bash scripts/e2e-nginx.sh",
    "e2e:firefox": "nightwatch -r e2e/html-reporter.js -c nightwatch.conf.js -e firefox",
    "e2e:safari": "nightwatch -r e2e/html-reporter.js -c nightwatch.conf.js -e safari",
    "e2e:edge": "nightwatch  -r e2e/html-reporter.js nightwatch.conf.js -e edge",
    "e2e:chrome": "nightwatch  -r e2e/html-reporter.js nightwatch.conf.js -e chrome",
    "dockerBuild": "docker build -f Dockerfile -t hugmesh.systems .",
    "dockerRun": "docker run  --env=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin --workdir=/ -p 8080:8080 --runtime=runc -d hugmesh.systems:latest"
  },
  "private": true,
  "dependencies": {
    "@angular-architects/native-federation": "^22.0.6",
    "@angular/animations": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-browser-dynamic": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@softarc/native-federation-node": "^4.0.0",
    "bootstrap": "^5.3.8",
    "es-module-shims": "^2.8.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "rxjs": "^7.8.2",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/localize": "^22.1.0",
    "@cucumber/cucumber": "^13.2.0",
    "@nightwatch/angular": "^3.1.1",
    "@nightwatch/mobile-helper": "^2.0.0",
